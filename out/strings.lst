     9 				        org $2000                       ; place the following code at memory address $2000
    10
    11
    12 				        .proc main                      ; declare procedure named "main", begin its scope
    13
    14 FFFF> 2000-2080> A9 01 +         mva #1 csrhinh                  ; hide the cursor
    15 2005 A9 06 85 54		        mva #6 rowcrs                   ; set output row
    16 2009 A9 0A 85 55		        mva #10 colcrs                  ; set output column
    17 				        
    18 200D A9 52 85 83		        mva #<string1 strptr_lo         ; low byte of string1 address
    19 2011 A9 20 85 84		        mva #>string1 strptr_hi         ; high byte o f string1 address
    20 2015 20 2E 20		        jsr print_string                ; print the string
    21
    22 2018 A9 07 85 54		        mva #7 rowcrs                   ; move row output pointer down 1
    23 201C A9 0A 85 55		        mva #10 colcrs                  ; move col output pointer back at 10
