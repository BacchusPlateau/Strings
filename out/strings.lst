Source: routines.asm
     1 				; print a string
     2 				; Assumptions
     3 				; strptr_lo = low address of the string
     4 				; strptr_hi = high address of the string
     5 				;       together we have a 16-bit address of the string
     6
     7 				; Y = index of current character to process, starts at 0
     8
     9 202E			        .proc print_string
    10 202E A0 00		        ldy #0
    11 2030			loop:
    12 2030 B1 83		        lda (strptr_lo),y               ; with an offset of Y bytes, grab the byte at the 16-bit address
    13 2032 C9 00		        cmp #0                          ; test if we found the 0 string terminator: A == 0?   
    14 2034 F0 0D		        beq exit                        ; if true, branch to exit
    15 2036 98			        tya                             ; A = Y
    16 2037 48			        pha                             ; push A onto the stack
    17 2038 B1 83		        lda (strptr_lo),y               ; re-fetch current byte of string
    18 203A 20 47 20		        jsr putchar                     ; call putchar to write a character out
    19 203D 68			        pla                             ; A = pop stack
    20 203E A8			        tay                             ; Y = A
    21 203F C8			        iny                             ; Y = Y + 1
    22 2040 4C 30 20		        jmp loop                        ; GOTO loop
    23 2043			exit:
    24 2043 60			        rts                             ; exit subroutine
    25 				        .endp
    26
    27 2044			stop:
    28 2044 4C 44 20		        jmp stop                        ; GOTO stop                   (infinite loop = program halts here)
    29
    30
    31 				; print a character
    32 				; Assumptions
    33 				; 1. the character is in register A
    34 				; 2. the character has been converted to ATASCII
    35 				; 3. before calling, save values of X and Y registers
    36
    37 2047			        .proc putchar
    38 2047 AA			        tax             ; X = A                       (save character from A into X because A is about to be clobbered)
    39 2048 AD 47 03		        lda putchar_ptr+1 ; A = memory[$347]          (load high byte of OS print routine address)
    40 204B 48			        pha             ; push A onto stack            (high byte on stack, will be popped second by rts)
    41 204C AD 46 03		        lda putchar_ptr ; A = memory[$346]            (load low byte of OS print routine address)
    42 204F 48			        pha             ; push A onto stack            (low byte on stack, will be popped first by rts)
    43 2050 8A			        txa             ; A = X                       (restore original character back into A because OS print routine expects character value in A)
    44 2051 60			        rts             ; RETURN                      (pops OS address from stack and jumps there, OS prints character in A, then returns to main)
    45 				        .endp           ; end of putchar procedure
